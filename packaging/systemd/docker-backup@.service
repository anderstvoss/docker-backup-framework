[Unit]
Description=Docker application backup for repository %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/docker-backup/backup-repository /etc/docker-backup/repos/%i.conf
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
