[Unit]
Description=Portable Docker backup retention for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/docker-backup/portable-retention --apply /etc/docker-backup/portable/%i.conf
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
