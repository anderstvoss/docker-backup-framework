#!/usr/bin/env bash
set -Eeuo pipefail

PRESERVE_CONFIG=false

usage() {
    cat <<'EOF'
Usage: install [--preserve-config]

Options:
  --preserve-config
      Install framework engines and systemd templates while preserving the
      existing /etc/docker-backup application, repository, portable, group,
      and secrets configuration. Timers are regenerated from the retained
      production configuration.

Without --preserve-config, configuration files included in the source tree
are deployed normally.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --preserve-config)
            PRESERVE_CONFIG=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [ "$EUID" -ne 0 ]; then
    echo "ERROR: installer must run as root" >&2
    exit 1
fi

SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ENGINE_DEST="/usr/local/lib/docker-backup"
APP_DEST="/etc/docker-backup/apps"
REPO_DEST="/etc/docker-backup/repos"
PORTABLE_DEST="/etc/docker-backup/portable"
GROUP_DEST="/etc/docker-backup/groups"
VERSION_DEST="/etc/docker-backup/DEPLOYED_VERSION"

echo "===== INSTALL DOCKER BACKUP FRAMEWORK ====="

if [ ! -x "$SOURCE_ROOT/scripts/version" ]; then
    echo "ERROR: version helper missing or not executable" >&2
    exit 1
fi

FRAMEWORK_VERSION="$("$SOURCE_ROOT/scripts/version" --version)"
GIT_COMMIT="$("$SOURCE_ROOT/scripts/version" --commit)"
GIT_DESCRIBE="$("$SOURCE_ROOT/scripts/version" --describe)"

echo "Source:            $SOURCE_ROOT"
echo "Framework version: $FRAMEWORK_VERSION"
echo "Git commit:        $GIT_COMMIT"
echo "Git describe:      $GIT_DESCRIBE"
echo "Preserve production config: $PRESERVE_CONFIG"

echo
echo "===== PREFLIGHT ====="

for file in \
    "$SOURCE_ROOT/src/backup-repository" \
    "$SOURCE_ROOT/src/retention-repository" \
    "$SOURCE_ROOT/src/maintain-repository" \
    "$SOURCE_ROOT/src/portable-backup" \
    "$SOURCE_ROOT/src/portable-retention" \
    "$SOURCE_ROOT/src/backup-group" \
    "$SOURCE_ROOT/src/validate-application-recovery" \
    "$SOURCE_ROOT/src/validate-group-recovery" \
    "$SOURCE_ROOT/scripts/acceptance-test" \
    "$SOURCE_ROOT/scripts/resolve-snapshot" \
    "$SOURCE_ROOT/scripts/validate-group" \
    "$SOURCE_ROOT/scripts/validate-group-manifest"
do
    if [ ! -f "$file" ]; then
        echo "ERROR: missing source file: $file" >&2
        exit 1
    fi
done

bash -n "$SOURCE_ROOT/src/backup-repository"
bash -n "$SOURCE_ROOT/src/retention-repository"
bash -n "$SOURCE_ROOT/src/maintain-repository"
bash -n "$SOURCE_ROOT/src/portable-backup"
bash -n "$SOURCE_ROOT/src/portable-retention"
bash -n "$SOURCE_ROOT/src/backup-group"
bash -n "$SOURCE_ROOT/src/validate-application-recovery"
bash -n "$SOURCE_ROOT/src/validate-group-recovery"
bash -n "$SOURCE_ROOT/scripts/acceptance-test"
bash -n "$SOURCE_ROOT/scripts/resolve-snapshot"
bash -n "$SOURCE_ROOT/scripts/validate-group"
bash -n "$SOURCE_ROOT/scripts/validate-group-manifest"

if [ "$PRESERVE_CONFIG" = false ]; then
    for config_dir in \
        "$SOURCE_ROOT/config/apps" \
        "$SOURCE_ROOT/config/repos" \
        "$SOURCE_ROOT/config/portable" \
        "$SOURCE_ROOT/config/groups"
    do
        if [ ! -d "$config_dir" ]; then
            echo "ERROR: missing configuration directory: $config_dir" >&2
            exit 1
        fi

        if ! compgen -G "$config_dir/*.conf" >/dev/null; then
            echo "ERROR: no configuration files found in: $config_dir" >&2
            exit 1
        fi
    done
else
    for config_dir in \
        "$APP_DEST" \
        "$REPO_DEST" \
        "$PORTABLE_DEST"
    do
        if [ ! -d "$config_dir" ]; then
            echo "ERROR: required production configuration directory missing: $config_dir" >&2
            exit 1
        fi

        if ! compgen -G "$config_dir/*.conf" >/dev/null; then
            echo "ERROR: no production configuration files found in: $config_dir" >&2
            exit 1
        fi
    done
fi

echo "PASS: source validation"

echo
echo "===== INSTALL DIRECTORIES ====="

install -d -o root -g root -m 0750 \
    "$ENGINE_DEST" \
    "$APP_DEST" \
    "$REPO_DEST" \
    "$PORTABLE_DEST" \
    "$GROUP_DEST"

# Do not recreate or modify existing secrets.
if [ ! -d /etc/docker-backup/secrets ]; then
    install -d -o root -g root -m 0700 \
        /etc/docker-backup/secrets
fi

echo
echo "===== INSTALL ENGINES ====="

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/backup-repository" \
    "$ENGINE_DEST/backup-repository"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/retention-repository" \
    "$ENGINE_DEST/retention-repository"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/maintain-repository" \
    "$ENGINE_DEST/maintain-repository"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/portable-backup" \
    "$ENGINE_DEST/portable-backup"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/portable-retention" \
    "$ENGINE_DEST/portable-retention"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/backup-group" \
    "$ENGINE_DEST/backup-group"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/validate-application-recovery" \
    "$ENGINE_DEST/validate-application-recovery"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/src/validate-group-recovery" \
    "$ENGINE_DEST/validate-group-recovery"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/scripts/acceptance-test" \
    "$ENGINE_DEST/acceptance-test"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/scripts/resolve-snapshot" \
    "$ENGINE_DEST/resolve-snapshot"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/scripts/validate-group" \
    "$ENGINE_DEST/validate-group"

install -o root -g root -m 0750 \
    "$SOURCE_ROOT/scripts/validate-group-manifest" \
    "$ENGINE_DEST/validate-group-manifest"

echo
echo "===== INSTALL CONFIGURATION ====="

if [ "$PRESERVE_CONFIG" = true ]; then
    echo "PASS: preserving existing production configuration"
else
    for config in "$SOURCE_ROOT"/config/apps/*.conf; do
        install -o root -g root -m 0640 \
            "$config" \
            "$APP_DEST/$(basename "$config")"
    done

    for config in "$SOURCE_ROOT"/config/repos/*.conf; do
        install -o root -g root -m 0640 \
            "$config" \
            "$REPO_DEST/$(basename "$config")"
    done

    for config in "$SOURCE_ROOT"/config/portable/*.conf; do
        install -o root -g root -m 0640 \
            "$config" \
            "$PORTABLE_DEST/$(basename "$config")"
    done

    for config in "$SOURCE_ROOT"/config/groups/*.conf; do
        install -o root -g root -m 0640 \
            "$config" \
            "$GROUP_DEST/$(basename "$config")"
    done
fi

cat > "$VERSION_DEST" <<EOF
FRAMEWORK_VERSION=$FRAMEWORK_VERSION
GIT_COMMIT=$GIT_COMMIT
GIT_DESCRIBE=$GIT_DESCRIBE
EOF

chown root:root "$VERSION_DEST"
chmod 0644 "$VERSION_DEST"

echo
echo "===== INSTALL SYSTEMD TEMPLATES ====="

for unit in "$SOURCE_ROOT"/packaging/systemd/*.service; do
    install -o root -g root -m 0644         "$unit"         "/etc/systemd/system/$(basename "$unit")"
done

systemctl daemon-reload

echo
echo "===== RENDER REPOSITORY TIMERS ====="

for config in "$REPO_DEST"/*.conf; do
    "$SOURCE_ROOT/scripts/render-timers" "$config"
done

echo
echo "===== RENDER PORTABLE TIMERS ====="

for config in "$PORTABLE_DEST"/*.conf; do
    "$SOURCE_ROOT/scripts/render-portable-timers" "$config"
done

echo
echo "===== VERIFY INSTALLED COPIES ====="

cmp "$SOURCE_ROOT/src/backup-repository" \
    "$ENGINE_DEST/backup-repository"

cmp "$SOURCE_ROOT/src/retention-repository" \
    "$ENGINE_DEST/retention-repository"

cmp "$SOURCE_ROOT/src/maintain-repository" \
    "$ENGINE_DEST/maintain-repository"

cmp "$SOURCE_ROOT/src/portable-backup" \
    "$ENGINE_DEST/portable-backup"

cmp "$SOURCE_ROOT/src/portable-retention" \
    "$ENGINE_DEST/portable-retention"

cmp "$SOURCE_ROOT/src/backup-group" \
    "$ENGINE_DEST/backup-group"

cmp "$SOURCE_ROOT/src/validate-application-recovery" \
    "$ENGINE_DEST/validate-application-recovery"

cmp "$SOURCE_ROOT/src/validate-group-recovery" \
    "$ENGINE_DEST/validate-group-recovery"

cmp "$SOURCE_ROOT/scripts/acceptance-test" \
    "$ENGINE_DEST/acceptance-test"

cmp "$SOURCE_ROOT/scripts/resolve-snapshot" \
    "$ENGINE_DEST/resolve-snapshot"

cmp "$SOURCE_ROOT/scripts/validate-group" \
    "$ENGINE_DEST/validate-group"

cmp "$SOURCE_ROOT/scripts/validate-group-manifest" \
    "$ENGINE_DEST/validate-group-manifest"

if [ "$PRESERVE_CONFIG" = false ]; then
    for config in "$SOURCE_ROOT"/config/apps/*.conf; do
        cmp "$config" "$APP_DEST/$(basename "$config")"
    done

    for config in "$SOURCE_ROOT"/config/repos/*.conf; do
        cmp "$config" "$REPO_DEST/$(basename "$config")"
    done

    for config in "$SOURCE_ROOT"/config/portable/*.conf; do
        cmp "$config" "$PORTABLE_DEST/$(basename "$config")"
    done

    for config in "$SOURCE_ROOT"/config/groups/*.conf; do
        cmp "$config" "$GROUP_DEST/$(basename "$config")"
    done

    echo "PASS: installed files and configuration match source"
else
    echo "PASS: installed engines match source; production configuration preserved"
fi

echo
echo "===== RUNTIME INDEPENDENCE ====="

if grep -RqsF "$SOURCE_ROOT" \
    "$ENGINE_DEST" \
    "$APP_DEST" \
    "$REPO_DEST" \
    "$PORTABLE_DEST" \
    "$GROUP_DEST"; then
    echo "ERROR: installed runtime references source checkout" >&2
    exit 1
fi

echo "PASS: runtime has no references to source checkout"

echo
echo "PASS: framework installation complete"
