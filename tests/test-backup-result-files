#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

BIN="$TMP/bin"
ETC="$TMP/etc/docker-backup"
APP_STATE="$TMP/app-state"
REPO_DIR="$TMP/restic-repo"
PORTABLE_ROOT="$TMP/portable"
RESULTS="$TMP/results"

mkdir -p \
    "$BIN" \
    "$ETC/apps" \
    "$ETC/repos" \
    "$ETC/portable" \
    "$APP_STATE" \
    "$REPO_DIR" \
    "$PORTABLE_ROOT" \
    "$RESULTS"

printf '%s\n' test > "$APP_STATE/file.txt"
printf '%s\n' password > "$TMP/restic-password"

cat > "$ETC/apps/app-one.conf" <<EOF_APP
APP_NAME="app-one"
COMPOSE_DIR="$TMP/compose"
DB_TYPE="none"
DB_BACKUP_MODE="none"
DB_CONTAINER=""
BACKUP_PATHS=(
    "$APP_STATE"
)
EXCLUDE_PATHS=()
EOF_APP

mkdir -p "$TMP/compose"

cat > "$ETC/repos/app-one-operational.conf" <<EOF_REPO
REPO_NAME="app-one-operational"
APP_NAME="app-one"
REPOSITORY="$REPO_DIR"
PASSWORD_FILE="$TMP/restic-password"
STORAGE_TYPE="local"
EOF_REPO

cat > "$ETC/portable/app-one.conf" <<EOF_PORTABLE
PORTABLE_NAME="app-one"
APP_NAME="app-one"
BACKUP_ROOT="$PORTABLE_ROOT"
STORAGE_TYPE="local"
EOF_PORTABLE

cat > "$BIN/hostname" <<'EOF_HOSTNAME'
#!/usr/bin/env bash
printf '%s\n' test-host
EOF_HOSTNAME

cat > "$BIN/restic" <<'EOF_RESTIC'
#!/usr/bin/env bash
set -Eeuo pipefail

STATE="${RESTIC_TEST_STATE:?}"

cmd="${1:-}"
shift || true

case "$cmd" in
    snapshots)
        if [[ "${1:-}" == "--json" ]]; then
            state="$(cat "$STATE" 2>/dev/null || printf '%s' initial)"

            case "$state" in
                initial)
                    printf '%s\n' '[]'
                    ;;
                files-building)
                    cat <<'JSON'
[
  {
    "id": "1111111111111111111111111111111111111111111111111111111111111111",
    "tags": [
      "app:app-one",
      "repo:operational",
      "component:files",
      "generation:GENERATION_PLACEHOLDER",
      "state:building"
    ]
  }
]
JSON
                    ;;
                files-complete)
                    cat <<'JSON'
[
  {
    "id": "2222222222222222222222222222222222222222222222222222222222222222",
    "tags": [
      "app:app-one",
      "repo:operational",
      "component:files",
      "generation:GENERATION_PLACEHOLDER",
      "state:complete"
    ]
  }
]
JSON
                    ;;
            esac
        else
            exit 0
        fi
        ;;

    backup)
        printf '%s\n' files-building > "$STATE"
        printf '%s\n' "snapshot 11111111 saved"
        ;;

    tag)
        printf '%s\n' files-complete > "$STATE"
        ;;

    forget)
        exit 0
        ;;

    *)
        echo "unexpected restic command: $cmd" >&2
        exit 1
        ;;
esac
EOF_RESTIC

chmod +x "$BIN/hostname" "$BIN/restic"

# The production engines resolve application config from /etc/docker-backup.
# Patch only disposable test copies to use the test configuration root.
cp "$ROOT/src/backup-repository" "$TMP/backup-repository"
cp "$ROOT/src/portable-backup" "$TMP/portable-backup"

python3 - "$TMP/backup-repository" "$TMP/portable-backup" "$ETC" <<'PY'
from pathlib import Path
import sys

for name in sys.argv[1:3]:
    p = Path(name)
    s = p.read_text()
    s = s.replace(
        'APP_CONFIG="/etc/docker-backup/apps/${APP_NAME}.conf"',
        f'APP_CONFIG="{sys.argv[3]}/apps/${{APP_NAME}}.conf"',
    )
    p.write_text(s)
PY

chmod +x "$TMP/backup-repository" "$TMP/portable-backup"

# The mocked Restic JSON must contain the actual dynamically generated
# generation ID. Wrap restic so the first backup invocation captures the
# generation from its tags and substitutes it into later JSON responses.
mv "$BIN/restic" "$BIN/restic-real"

cat > "$BIN/restic" <<'EOF_WRAPPER'
#!/usr/bin/env bash
set -Eeuo pipefail

REAL="$(dirname "$0")/restic-real"
GEN_FILE="${RESTIC_TEST_GENERATION:?}"

if [[ "${1:-}" == "backup" ]]; then
    for arg in "$@"; do
        case "$arg" in
            generation:*)
                printf '%s\n' "${arg#generation:}" > "$GEN_FILE"
                ;;
        esac
    done
fi

if [[ "${1:-}" == "snapshots" && "${2:-}" == "--json" ]]; then
    output="$("$REAL" "$@")"
    generation="$(cat "$GEN_FILE" 2>/dev/null || true)"
    printf '%s\n' "${output//GENERATION_PLACEHOLDER/$generation}"
else
    exec "$REAL" "$@"
fi
EOF_WRAPPER

chmod +x "$BIN/restic"

echo "=== repository result file ==="

RESTIC_TEST_STATE="$TMP/restic-state" \
RESTIC_TEST_GENERATION="$TMP/restic-generation" \
PATH="$BIN:$PATH" \
    "$TMP/backup-repository" \
    "$ETC/repos/app-one-operational.conf" \
    --result-file "$RESULTS/restic.result"

cat "$RESULTS/restic.result"

grep -Fx 'RESULT=PASS' "$RESULTS/restic.result"
grep -Fx 'APPLICATION=app-one' "$RESULTS/restic.result"
grep -Fx 'REPOSITORY=app-one-operational' "$RESULTS/restic.result"
grep -Eq '^RESTIC_GENERATION=.+$' "$RESULTS/restic.result"

grep -Fx \
    'FILES_SNAPSHOT=2222222222222222222222222222222222222222222222222222222222222222' \
    "$RESULTS/restic.result"

if grep -Fq \
    '1111111111111111111111111111111111111111111111111111111111111111' \
    "$RESULTS/restic.result"; then
    echo "FAIL: transient building snapshot leaked into result file" >&2
    exit 1
fi

test "$(stat -c '%a' "$RESULTS/restic.result")" = "600"

echo "PASS: repository result records final immutable snapshot"

echo
echo "=== portable result file ==="

PATH="$BIN:$PATH" \
    "$TMP/portable-backup" \
    "$ETC/portable/app-one.conf" \
    --result-file "$RESULTS/portable.result"

cat "$RESULTS/portable.result"

grep -Fx 'RESULT=PASS' "$RESULTS/portable.result"
grep -Fx 'APPLICATION=app-one' "$RESULTS/portable.result"
grep -Fx 'PORTABLE_TARGET=app-one' "$RESULTS/portable.result"
grep -Eq "^PORTABLE_SET=${PORTABLE_ROOT}/" "$RESULTS/portable.result"

portable_set="$(
    sed -n 's/^PORTABLE_SET=//p' "$RESULTS/portable.result"
)"

test -d "$portable_set"
test -s "$portable_set/app-state.tar.gz"
test -s "$portable_set/SHA256SUMS"
test "$(stat -c '%a' "$RESULTS/portable.result")" = "600"

echo "PASS: portable result records completed recovery set"

echo
echo "PASS: backup result-file regression suite"
