#!/usr/bin/env bash
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_ROOT="$(mktemp -d)"
trap 'rm -rf "$TMP_ROOT"' EXIT

prepare_mock_commands() {
    local bindir="$1"

    mkdir -p "$bindir"

    cat > "$bindir/systemctl" <<'STUB'
#!/usr/bin/env bash
set -Eeuo pipefail

case "${1:-}" in
    is-enabled|is-active)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
STUB

    cat > "$bindir/install" <<'STUB'
#!/usr/bin/env bash
set -Eeuo pipefail

args=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|-g)
            shift
            [ "$#" -gt 0 ] || exit 2
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

exec /usr/bin/install "${args[@]}"
STUB

    chmod +x \
        "$bindir/systemctl" \
        "$bindir/install"
}

prepare_case() {
    local name="$1"
    local case_root="$TMP_ROOT/$name"
    local source="$case_root/source"
    local root="$case_root/root"
    local bin="$case_root/bin"

    mkdir -p "$source" "$root" "$bin"
    cp -a "$REPO_ROOT/." "$source/"
    rm -rf "$source/.git"

    # Redirect host-specific paths into the disposable test root and bypass
    # root enforcement only inside this disposable source copy.
    python3 - "$source/scripts/deployment-drill" <<'PY'
from pathlib import Path
import sys

p = Path(sys.argv[1])
s = p.read_text()

replacements = {
    'if [ "$EUID" -ne 0 ]; then':
        'if [ "${DRILL_TEST_MODE:-0}" != "1" ] && [ "$EUID" -ne 0 ]; then',

    'RUNTIME_ROOT="/usr/local/lib/docker-backup"':
        'RUNTIME_ROOT="${TEST_ROOT:?}/usr/local/lib/docker-backup"',

    'ETC_ROOT="/etc/docker-backup"':
        'ETC_ROOT="${TEST_ROOT:?}/etc/docker-backup"',

    'LOG_DIR="/var/log/docker-backup/acceptance"':
        'LOG_DIR="${TEST_ROOT:?}/var/log/docker-backup/acceptance"',

    'TMP_ROOT="$(mktemp -d /run/docker-backup-deployment-drill.XXXXXX)"':
        'TMP_ROOT="$(mktemp -d "${TEST_ROOT:?}/run/docker-backup-deployment-drill.XXXXXX")"',
}

for old, new in replacements.items():
    if old not in s:
        raise SystemExit(f"test patch target not found: {old}")
    s = s.replace(old, new)

p.write_text(s)
PY

    # Replace the acceptance harness with a deterministic test double.
    cat > "$source/scripts/acceptance-test" <<'STUB'
#!/usr/bin/env bash
set -Eeuo pipefail

echo "===== MOCK ACCEPTANCE ====="
echo "Restic generation: generation-test-001"
echo "Portable set:      /mock/portable/2026-01-01_000000Z"
echo "DB snapshot:       aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
echo "Files snapshot:    bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
echo "PASS: mock acceptance"
STUB

    # Snapshot resolution is not exercised directly by the outer drill, but
    # must remain part of runtime parity.
    cat > "$source/scripts/resolve-snapshot" <<'STUB'
#!/usr/bin/env bash
set -Eeuo pipefail
echo "mock-resolver"
STUB

    # Repository maintenance is invoked only for the source-independence test.
    cat > "$source/src/maintain-repository" <<'STUB'
#!/usr/bin/env bash
set -Eeuo pipefail

if [ "${FAIL_MAINTAIN:-0}" = "1" ]; then
    echo "ERROR: injected repository-maintenance failure" >&2
    exit 55
fi

echo "PASS: mock repository maintenance"
STUB

    # The outer drill is what is under test, so use a deterministic installer
    # which performs the minimum deployment contract needed by the drill.
    cat > "$source/scripts/install" <<'STUB'
#!/usr/bin/env bash
set -Eeuo pipefail

if [ "${FAIL_INSTALL:-0}" = "1" ]; then
    echo "ERROR: injected installation failure" >&2
    exit 42
fi

SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME_ROOT="${TEST_ROOT:?}/usr/local/lib/docker-backup"
ETC_ROOT="${TEST_ROOT:?}/etc/docker-backup"

mkdir -p "$RUNTIME_ROOT" "$ETC_ROOT/groups"

for engine in \
    backup-repository \
    retention-repository \
    maintain-repository \
    portable-backup \
    portable-retention \
    backup-group \
    validate-application-recovery
do
    cp "$SOURCE_ROOT/src/$engine" "$RUNTIME_ROOT/$engine"
    chmod 0750 "$RUNTIME_ROOT/$engine"
done

for tool in \
    acceptance-test \
    resolve-snapshot \
    validate-group \
    validate-group-manifest
do
    cp "$SOURCE_ROOT/scripts/$tool" "$RUNTIME_ROOT/$tool"
    chmod 0750 "$RUNTIME_ROOT/$tool"
done

"$SOURCE_ROOT/scripts/version" > "$ETC_ROOT/DEPLOYED_VERSION"

echo "PASS: mock installation"
STUB

    chmod +x \
        "$source/scripts/deployment-drill" \
        "$source/scripts/install" \
        "$source/scripts/acceptance-test" \
        "$source/scripts/resolve-snapshot" \
        "$source/scripts/validate-group" \
        "$source/scripts/validate-group-manifest" \
        "$source/src/backup-group" \
        "$source/src/validate-application-recovery" \
        "$source/src/maintain-repository"

    # Create a real disposable Git repository so clean/dirty and exact commit
    # identity checks exercise real Git behavior.
    git -C "$source" init -q
    git -C "$source" config user.name "Deployment Drill Test"
    git -C "$source" config user.email "test@example.invalid"
    git -C "$source" add .
    git -C "$source" commit -qm "Disposable deployment-drill fixture"

    mkdir -p \
        "$root/etc/docker-backup/apps" \
        "$root/etc/docker-backup/repos" \
        "$root/etc/docker-backup/portable" \
        "$root/etc/docker-backup/secrets" \
        "$root/usr/local/lib/docker-backup" \
        "$root/var/log/docker-backup" \
        "$root/run"

    cat > "$root/etc/docker-backup/apps/test-app.conf" <<'CONF'
APP_NAME="test-app"
CONF

    cat > "$root/etc/docker-backup/repos/test-app-operational.conf" <<'CONF'
REPO_NAME="test-app-operational"
APP_NAME="test-app"
TIMERS_ENABLED="true"
CONF

    cat > "$root/etc/docker-backup/portable/test-app.conf" <<'CONF'
PORTABLE_NAME="test-app"
APP_NAME="test-app"
TIMERS_ENABLED="true"
CONF

    printf '%s\n' 'test-secret-placeholder' \
        > "$root/etc/docker-backup/secrets/test.password"

    chmod 0600 "$root/etc/docker-backup/secrets/test.password"

    prepare_mock_commands "$bin"

    printf '%s\n' "$case_root"
}

run_drill() {
    local case_root="$1"
    shift

    local source="$case_root/source"
    local root="$case_root/root"
    local bin="$case_root/bin"

    DRILL_TEST_MODE=1 \
    TEST_ROOT="$root" \
    PATH="$bin:$PATH" \
    "$@" \
    "$source/scripts/deployment-drill" \
        "$root/etc/docker-backup/repos/test-app-operational.conf" \
        "$root/etc/docker-backup/portable/test-app.conf"
}

latest_log() {
    local case_root="$1"

    find \
        "$case_root/root/var/log/docker-backup/acceptance" \
        -maxdepth 1 \
        -type f \
        -name '*.log' \
        -print \
        | sort \
        | tail -n1
}

echo "=== dirty checkout rejection ==="

CASE_ROOT="$(prepare_case dirty)"

printf '%s\n' 'dirty' >> "$CASE_ROOT/source/README.md"

if run_drill "$CASE_ROOT" \
    > "$CASE_ROOT/output.log" 2>&1
then
    echo "ERROR: dirty checkout was accepted" >&2
    exit 1
fi

grep -F \
    'ERROR: source checkout is dirty' \
    "$CASE_ROOT/output.log"

test -d "$CASE_ROOT/source"

echo "PASS: dirty checkout rejected"

echo
echo "=== failed deployment logging ==="

CASE_ROOT="$(prepare_case install-failure)"

if run_drill "$CASE_ROOT" env FAIL_INSTALL=1 \
    > "$CASE_ROOT/output.log" 2>&1
then
    echo "ERROR: injected installation failure was accepted" >&2
    exit 1
fi

LOG_FILE="$(latest_log "$CASE_ROOT")"

test -n "$LOG_FILE"
grep -Fx 'RESULT=FAIL' "$LOG_FILE"
grep -Fx 'LAST_STAGE=configuration-preserving deployment' "$LOG_FILE"
test -d "$CASE_ROOT/source"

echo "PASS: failed deployment produced FAIL validation record"

echo
echo "=== source restoration after independence failure ==="

CASE_ROOT="$(prepare_case independence-failure)"
EXPECTED_COMMIT="$(git -C "$CASE_ROOT/source" rev-parse HEAD)"

if run_drill "$CASE_ROOT" env FAIL_MAINTAIN=1 \
    > "$CASE_ROOT/output.log" 2>&1
then
    echo "ERROR: injected independence failure was accepted" >&2
    exit 1
fi

test -d "$CASE_ROOT/source"
test "$(git -C "$CASE_ROOT/source" rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git -C "$CASE_ROOT/source" status --porcelain)"

LOG_FILE="$(latest_log "$CASE_ROOT")"

grep -Fx 'RESULT=FAIL' "$LOG_FILE"
grep -Fx 'ACCEPTANCE=PASS' "$LOG_FILE"
grep -Fx 'SOURCE_INDEPENDENCE=NOT_RUN' "$LOG_FILE"
grep -Fx 'LAST_STAGE=source-checkout independence' "$LOG_FILE"

echo "PASS: source checkout restored after independence failure"

echo
echo "=== successful deployment drill ==="

CASE_ROOT="$(prepare_case success)"
EXPECTED_COMMIT="$(git -C "$CASE_ROOT/source" rev-parse HEAD)"

run_drill "$CASE_ROOT" \
    > "$CASE_ROOT/output.log" 2>&1

test -d "$CASE_ROOT/source"
test "$(git -C "$CASE_ROOT/source" rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git -C "$CASE_ROOT/source" status --porcelain)"

LOG_FILE="$(latest_log "$CASE_ROOT")"

grep -Fx 'RESULT=PASS' "$LOG_FILE"
grep -Fx 'FRAMEWORK_VERSION=1.0.0' "$LOG_FILE"
grep -Fx "GIT_COMMIT=$EXPECTED_COMMIT" "$LOG_FILE"
grep -Fx 'APPLICATION=test-app' "$LOG_FILE"
grep -Fx 'REPOSITORY=test-app-operational' "$LOG_FILE"
grep -Fx 'PORTABLE_TARGET=test-app' "$LOG_FILE"
grep -Fx 'RESTIC_GENERATION=generation-test-001' "$LOG_FILE"
grep -Fx 'PORTABLE_SET=/mock/portable/2026-01-01_000000Z' "$LOG_FILE"
grep -Fx \
    'DB_SNAPSHOT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
    "$LOG_FILE"
grep -Fx \
    'FILES_SNAPSHOT=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
    "$LOG_FILE"
grep -Fx 'CONFIG_PRESERVED=PASS' "$LOG_FILE"
grep -Fx 'SECRETS_PRESERVED=PASS' "$LOG_FILE"
grep -Fx 'RUNTIME_PARITY=PASS' "$LOG_FILE"
grep -Fx 'TIMERS=PASS' "$LOG_FILE"
grep -Fx 'ACCEPTANCE=PASS' "$LOG_FILE"
grep -Fx 'SOURCE_INDEPENDENCE=PASS' "$LOG_FILE"
grep -Fx 'LAST_STAGE=completed' "$LOG_FILE"

# This fixture starts without a production groups directory. A
# preserve-config deployment must create it without populating source examples.
test -d "$CASE_ROOT/root/etc/docker-backup/groups"
test -z "$(
    find "$CASE_ROOT/root/etc/docker-backup/groups"         -mindepth 1         -type f         -print -quit
)"

echo "PASS: successful drill recorded exact candidate and recovery identities"
echo "PASS: v1.0-style host received an empty groups directory"

echo
echo "=== existing group configuration preservation ==="

CASE_ROOT="$(prepare_case group-preservation)"
EXPECTED_COMMIT="$(git -C "$CASE_ROOT/source" rev-parse HEAD)"

mkdir -p "$CASE_ROOT/root/etc/docker-backup/groups"

cat > "$CASE_ROOT/root/etc/docker-backup/groups/production-group.conf" <<'EOF_GROUP'
GROUP_NAME="production-group"
GROUP_MEMBERS=(
    "test-app|test-app-operational|test-app"
)
EOF_GROUP

GROUP_HASH="$(
    sha256sum         "$CASE_ROOT/root/etc/docker-backup/groups/production-group.conf"         | awk '{print $1}'
)"

run_drill "$CASE_ROOT"     > "$CASE_ROOT/output.log" 2>&1

test -d "$CASE_ROOT/source"
test "$(git -C "$CASE_ROOT/source" rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git -C "$CASE_ROOT/source" status --porcelain)"

test "$GROUP_HASH" = "$(
    sha256sum         "$CASE_ROOT/root/etc/docker-backup/groups/production-group.conf"         | awk '{print $1}'
)"

test ! -e     "$CASE_ROOT/root/etc/docker-backup/groups/example.conf"

LOG_FILE="$(latest_log "$CASE_ROOT")"

grep -Fx 'RESULT=PASS' "$LOG_FILE"
grep -Fx 'CONFIG_PRESERVED=PASS' "$LOG_FILE"
grep -Fx 'RUNTIME_PARITY=PASS' "$LOG_FILE"
grep -Fx 'LAST_STAGE=completed' "$LOG_FILE"

echo "PASS: existing production group configuration preserved"

echo
echo "PASS: deployment-drill regression suite"
