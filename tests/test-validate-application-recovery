#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENGINE="${ROOT}/src/validate-application-recovery"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

APP_ROOT="$TMP/app"
REPO_ROOT="$TMP/repository"
PORTABLE_ROOT="$TMP/portable"
BIN="$TMP/bin"
RESULT_FILE="$TMP/result.env"

mkdir -p \
    "$APP_ROOT/config" \
    "$APP_ROOT/assets" \
    "$REPO_ROOT" \
    "$PORTABLE_ROOT/set-one" \
    "$BIN"

printf '%s\n' 'config-data' > "$APP_ROOT/config/example.conf"
printf '%s\n' 'asset-data' > "$APP_ROOT/assets/example.dat"

FILES_SNAPSHOT="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
GENERATION="20260821T190000Z-12345"

cat > "$TMP/app.conf" <<EOF_APP
APP_NAME="app-one"
COMPOSE_DIR="$TMP/compose"
DB_TYPE="none"
DB_BACKUP_MODE="none"
BACKUP_PATHS=(
    "$APP_ROOT/config"
    "$APP_ROOT/assets"
)
EXCLUDE_PATHS=(
    "$APP_ROOT/excluded"
)
EOF_APP

cat > "$TMP/repo.conf" <<EOF_REPO
REPO_NAME="app-one-operational"
APP_NAME="app-one"
REPOSITORY="$REPO_ROOT"
PASSWORD_FILE="$TMP/restic.password"
STORAGE_TYPE="local"
EOF_REPO

cat > "$TMP/portable.conf" <<EOF_PORTABLE
PORTABLE_NAME="app-one"
APP_NAME="app-one"
BACKUP_ROOT="$PORTABLE_ROOT"
STORAGE_TYPE="local"
EOF_PORTABLE

printf '%s\n' 'test-password' > "$TMP/restic.password"
chmod 0600 "$TMP/restic.password"

STAGE="$TMP/stage"

mkdir -p \
    "$STAGE${APP_ROOT}/config" \
    "$STAGE${APP_ROOT}/assets"

cp "$APP_ROOT/config/example.conf" \
    "$STAGE${APP_ROOT}/config/example.conf"

cp "$APP_ROOT/assets/example.dat" \
    "$STAGE${APP_ROOT}/assets/example.dat"

tar \
    -C "$STAGE" \
    -czf "$PORTABLE_ROOT/set-one/app-state.tar.gz" \
    .

(
    cd "$PORTABLE_ROOT/set-one"
    sha256sum app-state.tar.gz > SHA256SUMS
)

cat > "$BIN/restic" <<'EOF_RESTIC'
#!/usr/bin/env bash
set -Eeuo pipefail

FILES_SNAPSHOT="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
GENERATION="20260821T190000Z-12345"

case "$1" in
    snapshots)
        cat <<EOF_JSON
[
  {
    "id": "$FILES_SNAPSHOT",
    "tags": [
      "app:app-one",
      "repo:operational",
      "generation:$GENERATION",
      "component:files",
      "state:complete"
    ]
  }
]
EOF_JSON
        ;;

    restore)
        SNAPSHOT="$2"
        shift 2

        [[ "$SNAPSHOT" == "$FILES_SNAPSHOT" ]] || {
            echo "unexpected snapshot: $SNAPSHOT" >&2
            exit 1
        }

        TARGET=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --target)
                    shift
                    TARGET="$1"
                    ;;
            esac
            shift
        done

        [[ -n "$TARGET" ]] || exit 1

        mkdir -p \
            "$TARGET${TEST_APP_ROOT}/config" \
            "$TARGET${TEST_APP_ROOT}/assets"

        printf '%s\n' 'config-data' \
            > "$TARGET${TEST_APP_ROOT}/config/example.conf"

        printf '%s\n' 'asset-data' \
            > "$TARGET${TEST_APP_ROOT}/assets/example.dat"
        ;;

    *)
        echo "unexpected restic command: $*" >&2
        exit 1
        ;;
esac
EOF_RESTIC

chmod +x "$BIN/restic"

LOCK_ROOT="$TMP/locks"
mkdir -p "$LOCK_ROOT"

run_validator() {
    sudo env \
        "PATH=$BIN:$PATH" \
        "TEST_APP_ROOT=$APP_ROOT" \
        "DOCKER_BACKUP_LOCK_ROOT=$LOCK_ROOT" \
        "$ENGINE" "$@"
}

echo "=== successful DB_TYPE=none recovery validation ==="

run_validator \
    "$TMP/app.conf" \
    "$TMP/repo.conf" \
    "$TMP/portable.conf" \
    --generation "$GENERATION" \
    --files-snapshot "$FILES_SNAPSHOT" \
    --portable-set "$PORTABLE_ROOT/set-one" \
    --result-file "$RESULT_FILE"

RESULT_CONTENTS="$(sudo cat "$RESULT_FILE")"

grep -Fx 'RESULT=PASS' <<<"$RESULT_CONTENTS"
grep -Fx 'APPLICATION=app-one' <<<"$RESULT_CONTENTS"
grep -Fx 'REPOSITORY=app-one-operational' <<<"$RESULT_CONTENTS"
grep -Fx 'PORTABLE_TARGET=app-one' <<<"$RESULT_CONTENTS"
grep -Fx "RESTIC_GENERATION=$GENERATION" <<<"$RESULT_CONTENTS"
grep -Fx "FILES_SNAPSHOT=$FILES_SNAPSHOT" <<<"$RESULT_CONTENTS"
grep -Fx 'RESTIC_FILES=PASS' <<<"$RESULT_CONTENTS"
grep -Fx 'PORTABLE_FILES=PASS' <<<"$RESULT_CONTENTS"
grep -Fx 'DATABASE=SKIPPED' <<<"$RESULT_CONTENTS"

MODE="$(
    sudo stat -c '%a' "$RESULT_FILE"
)"

[[ "$MODE" == "600" ]] || {
    echo "ERROR: result file mode is $MODE, expected 600" >&2
    exit 1
}

echo "PASS: DB_TYPE=none recovery point validated"

echo
echo "=== immutable snapshot mismatch rejection ==="

BAD_SNAPSHOT="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

if run_validator \
       "$TMP/app.conf" \
       "$TMP/repo.conf" \
       "$TMP/portable.conf" \
       --generation "$GENERATION" \
       --files-snapshot "$BAD_SNAPSHOT" \
       --portable-set "$PORTABLE_ROOT/set-one" \
       > "$TMP/bad-snapshot.log" 2>&1
then
    echo "ERROR: wrong immutable snapshot was accepted" >&2
    exit 1
fi

grep -F \
    "expected immutable snapshot $BAD_SNAPSHOT" \
    "$TMP/bad-snapshot.log"

echo "PASS: wrong immutable snapshot rejected"

echo
echo "=== wrong generation rejection ==="

if run_validator \
       "$TMP/app.conf" \
       "$TMP/repo.conf" \
       "$TMP/portable.conf" \
       --generation "wrong-generation" \
       --files-snapshot "$FILES_SNAPSHOT" \
       --portable-set "$PORTABLE_ROOT/set-one" \
       > "$TMP/bad-generation.log" 2>&1
then
    echo "ERROR: wrong generation was accepted" >&2
    exit 1
fi

grep -F \
    'snapshot is missing required tag(s): generation:wrong-generation' \
    "$TMP/bad-generation.log"

echo "PASS: wrong generation rejected"

echo
echo "=== portable set containment rejection ==="

mkdir -p "$TMP/outside-set"

if run_validator \
       "$TMP/app.conf" \
       "$TMP/repo.conf" \
       "$TMP/portable.conf" \
       --generation "$GENERATION" \
       --files-snapshot "$FILES_SNAPSHOT" \
       --portable-set "$TMP/outside-set" \
       > "$TMP/outside.log" 2>&1
then
    echo "ERROR: portable set outside BACKUP_ROOT was accepted" >&2
    exit 1
fi

grep -F \
    'portable recovery set is outside configured BACKUP_ROOT' \
    "$TMP/outside.log"

echo "PASS: portable-set containment enforced"

echo
echo "PASS: validate-application-recovery regression suite"
