#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENGINE="${ROOT}/src/validate-application-recovery"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

APP_ROOT="$TMP/app"
REPO_ROOT="$TMP/repository"
PORTABLE_ROOT="$TMP/portable"
BIN="$TMP/bin"
LOCK_ROOT="$TMP/locks"
RESULT_FILE="$TMP/result.env"
DOCKER_LOG="$TMP/docker.log"

mkdir -p \
    "$APP_ROOT/files" \
    "$REPO_ROOT" \
    "$PORTABLE_ROOT/set-one" \
    "$BIN" \
    "$LOCK_ROOT" \
    "$TMP/compose"

FILES_SNAPSHOT="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
DB_SNAPSHOT="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
GENERATION="20260822T080000Z-12345"

printf '%s\n' 'file-data' > "$APP_ROOT/files/example.txt"

cat > "$TMP/app.conf" <<EOF_APP
APP_NAME="vikunja-test"
COMPOSE_DIR="$TMP/compose"
DB_TYPE="postgresql"
DB_BACKUP_MODE="logical"
DB_CONTAINER="vikunja-db"
DB_VALIDATION_LABEL="migration"
DB_VALIDATION_QUERY="SELECT id FROM migration WHERE id ~ '^[0-9]+\$' ORDER BY id DESC LIMIT 1;"
BACKUP_PATHS=(
    "$APP_ROOT/files"
)
EXCLUDE_PATHS=(
    "$APP_ROOT/db"
)
EOF_APP

cat > "$TMP/repo.conf" <<EOF_REPO
REPO_NAME="vikunja-test-operational"
APP_NAME="vikunja-test"
REPOSITORY="$REPO_ROOT"
PASSWORD_FILE="$TMP/restic.password"
STORAGE_TYPE="local"
EOF_REPO

cat > "$TMP/portable.conf" <<EOF_PORTABLE
PORTABLE_NAME="vikunja-test"
APP_NAME="vikunja-test"
BACKUP_ROOT="$PORTABLE_ROOT"
STORAGE_TYPE="local"
EOF_PORTABLE

printf '%s\n' 'test-password' > "$TMP/restic.password"
chmod 0600 "$TMP/restic.password"

STAGE="$TMP/stage"
mkdir -p "$STAGE${APP_ROOT}/files"

printf '%s\n' 'file-data' \
    > "$STAGE${APP_ROOT}/files/example.txt"

tar \
    -C "$STAGE" \
    -czf "$PORTABLE_ROOT/set-one/app-state.tar.gz" \
    .

cat > "$TMP/portable.sql" <<'SQL'
CREATE TABLE public.migration (
    id character varying(255),
    description character varying(255)
);

INSERT INTO public.migration (id, description)
VALUES ('20260802162816', '');
SQL

gzip -c "$TMP/portable.sql" \
    > "$PORTABLE_ROOT/set-one/database.sql.gz"

(
    cd "$PORTABLE_ROOT/set-one"
    sha256sum \
        app-state.tar.gz \
        database.sql.gz \
        > SHA256SUMS
)

cat > "$BIN/restic" <<'EOF_RESTIC'
#!/usr/bin/env bash
set -Eeuo pipefail

FILES_SNAPSHOT="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
DB_SNAPSHOT="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
GENERATION="20260822T080000Z-12345"

case "$1" in
    snapshots)
        cat <<EOF_JSON
[
  {
    "id": "$FILES_SNAPSHOT",
    "tags": [
      "app:vikunja-test",
      "repo:operational",
      "generation:$GENERATION",
      "component:files",
      "state:complete"
    ]
  },
  {
    "id": "$DB_SNAPSHOT",
    "tags": [
      "app:vikunja-test",
      "repo:operational",
      "generation:$GENERATION",
      "component:db",
      "state:complete"
    ]
  }
]
EOF_JSON
        ;;

    restore)
        snapshot="$2"
        shift 2

        target=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --target)
                    shift
                    target="$1"
                    ;;
            esac
            shift
        done

        [[ -n "$target" ]] || exit 1

        case "$snapshot" in
            "$FILES_SNAPSHOT")
                mkdir -p "$target${TEST_APP_ROOT}/files"

                printf '%s\n' 'file-data' \
                    > "$target${TEST_APP_ROOT}/files/example.txt"
                ;;

            "$DB_SNAPSHOT")
                mkdir -p "$target"

                cat > "$target/database.sql" <<'SQL'
CREATE TABLE public.migration (
    id character varying(255),
    description character varying(255)
);

INSERT INTO public.migration (id, description)
VALUES ('20260802162816', '');
SQL
                ;;

            *)
                echo "unexpected snapshot: $snapshot" >&2
                exit 1
                ;;
        esac
        ;;

    *)
        echo "unexpected restic command: $*" >&2
        exit 1
        ;;
esac
EOF_RESTIC

chmod +x "$BIN/restic"

cat > "$BIN/docker" <<'EOF_DOCKER'
#!/usr/bin/env bash
set -Eeuo pipefail

printf '%s\n' "$*" >> "$TEST_DOCKER_LOG"

if [[ "$1" == "compose" && "$2" == "ps" && "$3" == "-q" ]]; then
    echo "mock-postgres-container"
    exit 0
fi

if [[ "$1" == "inspect" ]]; then
    if [[ "$*" == *"{{.Config.Image}}"* ]]; then
        echo "postgres:18"
        exit 0
    fi

    if [[ "$*" == *"{{range .Config.Env}}"* ]]; then
        echo "POSTGRES_DB=vikunja"
        echo "POSTGRES_USER=vikunja"
        exit 0
    fi
fi

if [[ "$1" == "run" ]]; then
    echo "mock-container-id"
    exit 0
fi

if [[ "$1" == "rm" ]]; then
    exit 0
fi

if [[ "$1" == "exec" ]]; then
    # Consume piped SQL on imports.
    if [[ " $* " == *" -i "* ]] && [[ "$*" == *" psql "* ]]; then
        cat >/dev/null
        exit 0
    fi

    if [[ "$*" == *"--command=SELECT 1;"* ]] ||
       [[ "$*" == *"--command SELECT 1;"* ]]; then
        echo "1"
        exit 0
    fi

    if [[ "$*" == *" dropdb "* ]] ||
       [[ "$*" == *" createdb "* ]]; then
        exit 0
    fi

    if [[ "$*" == *"information_schema.tables"* ]]; then
        cat <<'METRICS'
tables=37
views=0
triggers=0
METRICS
        exit 0
    fi

    if [[ "$*" == *"SELECT id FROM migration WHERE id ~"* ]]; then
        echo "20260802162816"
        exit 0
    fi

    exit 0
fi

echo "unexpected docker command: $*" >&2
exit 1
EOF_DOCKER

chmod +x "$BIN/docker"

run_validator() {
    sudo env \
        "PATH=$BIN:$PATH" \
        "TEST_APP_ROOT=$APP_ROOT" \
        "TEST_DOCKER_LOG=$DOCKER_LOG" \
        "DOCKER_BACKUP_LOCK_ROOT=$LOCK_ROOT" \
        "$ENGINE" "$@"
}

echo "=== successful PostgreSQL recovery validation ==="

run_validator \
    "$TMP/app.conf" \
    "$TMP/repo.conf" \
    "$TMP/portable.conf" \
    --generation "$GENERATION" \
    --files-snapshot "$FILES_SNAPSHOT" \
    --db-snapshot "$DB_SNAPSHOT" \
    --portable-set "$PORTABLE_ROOT/set-one" \
    --result-file "$RESULT_FILE"

RESULT_CONTENTS="$(sudo cat "$RESULT_FILE")"

grep -Fx 'RESULT=PASS' <<<"$RESULT_CONTENTS"
grep -Fx 'APPLICATION=vikunja-test' <<<"$RESULT_CONTENTS"
grep -Fx 'DATABASE=PASS' <<<"$RESULT_CONTENTS"
grep -Fx "DB_SNAPSHOT=$DB_SNAPSHOT" <<<"$RESULT_CONTENTS"

grep -F 'docker-recovery-validation-vikunja-test-' "$DOCKER_LOG"
grep -F 'postgres:18' "$DOCKER_LOG"
grep -F -- '--tmpfs /var/lib/postgresql' "$DOCKER_LOG"
grep -F 'POSTGRES_USER=validation' "$DOCKER_LOG"
grep -F 'POSTGRES_DB=vikunja' "$DOCKER_LOG"

echo "PASS: PostgreSQL recovery point validated"

echo
echo "=== expected structural and semantic metrics ==="

run_validator \
    "$TMP/app.conf" \
    "$TMP/repo.conf" \
    "$TMP/portable.conf" \
    --generation "$GENERATION" \
    --files-snapshot "$FILES_SNAPSHOT" \
    --db-snapshot "$DB_SNAPSHOT" \
    --portable-set "$PORTABLE_ROOT/set-one" \
    > "$TMP/metrics.log" 2>&1

grep -Fx 'tables=37' "$TMP/metrics.log"
grep -Fx 'views=0' "$TMP/metrics.log"
grep -Fx 'triggers=0' "$TMP/metrics.log"
grep -Fx 'migration=20260802162816' "$TMP/metrics.log"

echo "PASS: PostgreSQL structure and semantic marker validated"

echo
echo "=== generic PostgreSQL validation without semantic marker ==="

GENERIC_APP_CONF="$TMP/app-generic.conf"

grep -v '^DB_VALIDATION_LABEL=' "$TMP/app.conf" \
    | grep -v '^DB_VALIDATION_QUERY=' \
    > "$GENERIC_APP_CONF"

run_validator \
    "$GENERIC_APP_CONF" \
    "$TMP/repo.conf" \
    "$TMP/portable.conf" \
    --generation "$GENERATION" \
    --files-snapshot "$FILES_SNAPSHOT" \
    --db-snapshot "$DB_SNAPSHOT" \
    --portable-set "$PORTABLE_ROOT/set-one" \
    > "$TMP/generic-db.log" 2>&1

grep -Fx 'tables=37' "$TMP/generic-db.log"
grep -Fx 'views=0' "$TMP/generic-db.log"
grep -Fx 'triggers=0' "$TMP/generic-db.log"

if grep -Fq 'migration=' "$TMP/generic-db.log"; then
    echo "ERROR: generic PostgreSQL validation unexpectedly emitted marker" >&2
    exit 1
fi

grep -Fq \
    'PASS: Restic and portable database structure agree' \
    "$TMP/generic-db.log"

echo "PASS: generic PostgreSQL validation does not require semantic marker"

echo
echo "=== missing DB snapshot rejection ==="

if run_validator \
       "$TMP/app.conf" \
       "$TMP/repo.conf" \
       "$TMP/portable.conf" \
       --generation "$GENERATION" \
       --files-snapshot "$FILES_SNAPSHOT" \
       --portable-set "$PORTABLE_ROOT/set-one" \
       > "$TMP/missing-db.log" 2>&1
then
    echo "ERROR: missing DB snapshot was accepted" >&2
    exit 1
fi

grep -F -- \
    '--db-snapshot is required for postgresql:logical' \
    "$TMP/missing-db.log"

echo "PASS: missing DB snapshot rejected"

echo
echo "=== wrong DB snapshot rejection ==="

BAD_DB="cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

if run_validator \
       "$TMP/app.conf" \
       "$TMP/repo.conf" \
       "$TMP/portable.conf" \
       --generation "$GENERATION" \
       --files-snapshot "$FILES_SNAPSHOT" \
       --db-snapshot "$BAD_DB" \
       --portable-set "$PORTABLE_ROOT/set-one" \
       > "$TMP/bad-db.log" 2>&1
then
    echo "ERROR: wrong DB snapshot was accepted" >&2
    exit 1
fi

grep -F \
    "expected immutable snapshot $BAD_DB" \
    "$TMP/bad-db.log"

echo "PASS: wrong DB snapshot rejected"

echo
echo "PASS: PostgreSQL validate-application-recovery regression suite"
